# Supabase 설정 (필수)
# Supabase 프로젝트에서 가져온 URL과 익명 키를 입력하세요
# https://app.supabase.com/project/YOUR_PROJECT_ID/settings/api
VUE_APP_SUPABASE_URL=https://your-project.supabase.co
VUE_APP_SUPABASE_ANON_KEY=your-anon-key-here

# API 서버 설정 (선택)
VUE_APP_API_URL=http://localhost:3000

# Vue 3 Feature Flags (기본값)
__VUE_OPTIONS_API__=true
__VUE_PROD_DEVTOOLS__=false
__VUE_PROD_HYDRATION_MISMATCH_DETAILS__=false